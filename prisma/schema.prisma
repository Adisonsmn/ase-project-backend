// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum IncomePeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ABANDONED
}

/// Kelompok usia untuk menyaring rekomendasi penambahan income.
/// Ditentukan dari dateOfBirth; GENERAL dipakai kalau tanggal lahir kosong.
enum AgeGroup {
  TEEN
  YOUNG_ADULT
  GENERAL
}

/// Hanya PUBLISHED yang tampil ke publik.
enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  displayName  String?
  avatarUrl    String?
  dateOfBirth  DateTime?
  role         Role      @default(USER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]
  categories   Category[]
  transactions Transaction[]
  savingRatio  SavingRatio?
  goals        SavingGoal[]
  articles     Article[]
  bookmarks    Bookmark[]
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Kategori transaksi.
/// userId null = kategori bawaan sistem, dipakai bersama oleh semua user.
model Category {
  id         String          @id @default(uuid())
  userId     String?
  name       String
  icon       String?
  type       TransactionType
  /// Kategori sistem tidak dapat diubah atau dihapus user.
  isSystem   Boolean         @default(false)
  /// Penampung transaksi saat kategori lain dihapus. Satu per TransactionType.
  isFallback Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  // Nama kategori unik per user. Kategori sistem (userId null) tidak tercakup
  // karena NULL selalu dianggap berbeda di Postgres; keunikannya dijaga seed
  // yang memakai id tetap.
  @@unique([userId, name, type])
  @@index([userId])
}

model Transaction {
  id         String          @id @default(uuid())
  userId     String
  categoryId String?
  /// Transaksi tabungan yang ditautkan ke sebuah target.
  goalId     String?
  type       TransactionType
  amount     Decimal         @db.Decimal(14, 2)
  note       String?
  /// Kapan transaksi terjadi menurut user (disimpan UTC).
  occurredAt DateTime
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Pengaman lapisan database. Pemindahan ke kategori fallback dilakukan
  // eksplisit di service sebelum kategori dihapus.
  category Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Menghapus goal tidak menghapus transaksinya; tautannya saja yang dilepas.
  goal     SavingGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([userId, categoryId])
  @@index([userId, type, occurredAt])
  @@index([goalId])
}

/// Preferensi rasio alokasi milik user. Satu baris per user: versi ini hanya
/// mendukung satu rasio aktif, bukan banyak profil.
model SavingRatio {
  id     String @id @default(uuid())
  userId String @unique

  /// Total ketiganya wajib 100, dijaga di lapisan validasi.
  needsPct   Int
  savingsPct Int
  funPct     Int

  /// Pemasukan terakhir yang dipakai menghitung, disimpan untuk prefill form.
  incomeAmount Decimal?      @db.Decimal(14, 2)
  period       IncomePeriod?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Target tabungan milik user. Satu user boleh punya beberapa target.
model SavingGoal {
  id     String @id @default(uuid())
  userId String

  title        String
  targetAmount Decimal  @db.Decimal(14, 2)
  targetDate   DateTime

  /// Cache hasil penjumlahan transaksi bertaut goal ini. Sumber kebenarannya
  /// tetap tabel Transaction; kolom ini disegarkan setiap progress dihitung
  /// supaya tidak pernah melenceng dari data transaksi.
  currentAmount Decimal @default(0) @db.Decimal(14, 2)

  status    GoalStatus @default(ACTIVE)
  /// Target utama yang ditonjolkan di beranda. Maksimal satu per user.
  isPrimary Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, status])
}

/// Ide penambahan income, disaring menurut kelompok usia.
/// Disimpan di database, bukan hardcode, supaya bisa ditambah admin nanti.
model IncomeIdea {
  id          String   @id @default(uuid())
  title       String
  description String
  ageGroup    AgeGroup

  estMonthlyMin Decimal @db.Decimal(14, 2)
  estMonthlyMax Decimal @db.Decimal(14, 2)
  /// 1 = paling ringan, 5 = paling menyita waktu.
  effortLevel   Int

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ageGroup, isActive])
}

/// Kategori artikel. Dikelola lewat seed dengan id tetap, bukan oleh user.
model ArticleCategory {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles Article[]
}

/// Artikel keuangan yang dikurasi manual oleh admin (F-14).
model Article {
  id           String        @id @default(uuid())
  /// Dipakai sebagai URL detail. Tidak berubah saat judul diubah, supaya
  /// tautan yang sudah dibagikan tidak putus.
  slug         String        @unique
  title        String
  summary      String
  content      String
  thumbnailUrl String?
  /// Atribusi sumber untuk tulisan yang merangkum media lain (mitigasi hak
  /// cipta, PRD bagian 9).
  sourceName   String?
  sourceUrl    String?
  categoryId   String
  /// Admin yang menulis. Dilepas, bukan ikut terhapus, kalau akunnya dihapus.
  authorId     String?
  status       ArticleStatus @default(DRAFT)
  /// Diisi saat pertama kali terbit dan tidak diubah lagi, sehingga urutan
  /// daftar tidak melompat setiap kali artikel diterbitkan ulang.
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Restrict: kategori yang masih berisi artikel tidak boleh terhapus diam-diam.
  category  ArticleCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author    User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  bookmarks Bookmark[]

  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
}

/// Artikel favorit milik user (F-16).
model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId, createdAt])
}
