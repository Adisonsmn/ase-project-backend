// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum IncomePeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ABANDONED
}

/// Kelompok usia untuk menyaring rekomendasi penambahan income.
/// Ditentukan dari dateOfBirth; GENERAL dipakai kalau tanggal lahir kosong.
enum AgeGroup {
  TEEN
  YOUNG_ADULT
  GENERAL
}

/// Hanya PUBLISHED yang tampil ke publik.
enum ArticleStatus {
  DRAFT
  PUBLISHED
}

/// Jenis akun hanya untuk label dan ikon. Aplikasi tidak terhubung ke bank
/// atau e-wallet sungguhan (PRD 1.3).
enum AccountType {
  CASH
  BANK
  EWALLET
  SAVINGS
  OTHER
}

enum SimInstrumentType {
  STOCK
  MUTUAL_FUND
}

/// Dipakai untuk tingkat risiko sekaligus potensi keuntungan instrumen.
enum SimLevel {
  LOW
  MEDIUM
  HIGH
}

enum SimStatus {
  RUNNING
  FINISHED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  avatarUrl    String?
  dateOfBirth  DateTime?
  role         Role      @default(USER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]
  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  transfers    Transfer[]
  savingRatio  SavingRatio?
  goals        SavingGoal[]
  articles     Article[]
  bookmarks    Bookmark[]
  simulations  SimulationSession[]
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  /// Sesi pengganti saat dicabut karena rotasi refresh token. Kosong kalau
  /// dicabut lewat logout atau karena reuse terdeteksi.
  replacedById String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Kategori transaksi.
/// userId null = kategori bawaan sistem, dipakai bersama oleh semua user.
model Category {
  id         String          @id @default(uuid())
  userId     String?
  name       String
  icon       String?
  type       TransactionType
  /// Kategori sistem tidak dapat diubah atau dihapus user.
  isSystem   Boolean         @default(false)
  /// Penampung transaksi saat kategori lain dihapus. Satu per TransactionType.
  isFallback Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  // Nama kategori unik per user. Kategori sistem (userId null) tidak tercakup
  // karena NULL selalu dianggap berbeda di Postgres; keunikannya dijaga seed
  // yang memakai id tetap.
  @@unique([userId, name, type])
  @@index([userId])
}

/// Tempat uang disimpan: dompet, rekening, celengan. Saldo sengaja tidak
/// disimpan sebagai kolom, tetapi dihitung dari saldo awal, transaksi, dan
/// transfer, supaya tidak pernah melenceng dari catatan.
model Account {
  id             String      @id @default(uuid())
  userId         String
  name           String
  type           AccountType
  icon           String?
  openingBalance Decimal     @default(0) @db.Decimal(14, 2)
  /// Dipakai kalau transaksi dicatat tanpa accountId. Tepat satu per user,
  /// dijaga service.
  isDefault      Boolean     @default(false)
  /// Akun lama diarsipkan, bukan dihapus, supaya riwayatnya tetap utuh.
  isArchived     Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  transfersOut Transfer[]    @relation("TransferFrom")
  transfersIn  Transfer[]    @relation("TransferTo")

  @@unique([userId, name])
  @@index([userId, isArchived])
}

/// Perpindahan uang antar akun milik user yang sama, mis. tarik tunai.
/// Bukan pemasukan atau pengeluaran, jadi tidak dicatat sebagai Transaction
/// dan tidak memengaruhi laporan. Biaya admin dicatat sebagai Transaction
/// EXPENSE bertaut (feeTransaction), jadi ikut laporan pengeluaran tanpa
/// disimpan dua kali.
model Transfer {
  id            String   @id @default(uuid())
  userId        String
  fromAccountId String
  toAccountId   String
  amount        Decimal  @db.Decimal(14, 2)
  note          String?
  occurredAt    DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NoAction dengan alasan yang sama seperti Transaction.account.
  fromAccount    Account      @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: NoAction)
  toAccount      Account      @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: NoAction)
  feeTransaction Transaction?

  @@index([userId, occurredAt])
  @@index([fromAccountId])
  @@index([toAccountId])
}

model Transaction {
  id         String          @id @default(uuid())
  userId     String
  accountId  String
  categoryId String?
  /// Transaksi tabungan yang ditautkan ke sebuah target.
  goalId     String?
  /// Terisi kalau transaksi ini biaya admin sebuah transfer. Diubah dan
  /// dihapus lewat transfernya, bukan langsung.
  transferId String?         @unique
  type       TransactionType
  amount     Decimal         @db.Decimal(14, 2)
  note       String?
  /// Kapan transaksi terjadi menurut user (disimpan UTC).
  occurredAt DateTime
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Akun yang masih punya transaksi tidak bisa dihapus. NoAction, bukan
  // Restrict: saat user dihapus, cascade ke Account dan Transaction terjadi
  // dalam satu statement, dan Restrict akan gagal kalau Account kebetulan
  // terhapus lebih dulu. NoAction baru diperiksa di akhir statement.
  account  Account     @relation(fields: [accountId], references: [id], onDelete: NoAction)
  // Pengaman lapisan database. Pemindahan ke kategori fallback dilakukan
  // eksplisit di service sebelum kategori dihapus.
  category Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Menghapus goal tidak menghapus transaksinya; tautannya saja yang dilepas.
  goal     SavingGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  // Biaya admin ikut terhapus bersama transfernya.
  transfer Transfer?   @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([userId, categoryId])
  @@index([userId, type, occurredAt])
  @@index([accountId])
  @@index([goalId])
}

/// Preferensi rasio alokasi milik user. Satu baris per user: versi ini hanya
/// mendukung satu rasio aktif, bukan banyak profil.
model SavingRatio {
  id     String @id @default(uuid())
  userId String @unique

  /// Total ketiganya wajib 100, dijaga di lapisan validasi.
  needsPct   Int
  savingsPct Int
  funPct     Int

  /// Pemasukan terakhir yang dipakai menghitung, disimpan untuk prefill form.
  incomeAmount Decimal?      @db.Decimal(14, 2)
  period       IncomePeriod?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Target tabungan milik user. Satu user boleh punya beberapa target.
model SavingGoal {
  id     String @id @default(uuid())
  userId String

  title        String
  targetAmount Decimal  @db.Decimal(14, 2)
  targetDate   DateTime

  /// Cache hasil penjumlahan transaksi bertaut goal ini. Sumber kebenarannya
  /// tetap tabel Transaction; kolom ini disegarkan setiap progress dihitung
  /// supaya tidak pernah melenceng dari data transaksi.
  currentAmount Decimal @default(0) @db.Decimal(14, 2)

  status    GoalStatus @default(ACTIVE)
  /// Target utama yang ditonjolkan di beranda. Maksimal satu per user.
  isPrimary Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, status])
}

/// Ide penambahan income, disaring menurut kelompok usia.
/// Disimpan di database, bukan hardcode, supaya bisa ditambah admin nanti.
model IncomeIdea {
  id          String   @id @default(uuid())
  title       String
  description String
  ageGroup    AgeGroup

  estMonthlyMin Decimal @db.Decimal(14, 2)
  estMonthlyMax Decimal @db.Decimal(14, 2)
  /// 1 = paling ringan, 5 = paling menyita waktu.
  effortLevel   Int

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ageGroup, isActive])
}

/// Kategori artikel. Dikelola lewat seed dengan id tetap, bukan oleh user.
model ArticleCategory {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles Article[]
}

/// Artikel keuangan yang dikurasi manual oleh admin (F-14).
model Article {
  id           String        @id @default(uuid())
  /// Dipakai sebagai URL detail. Tidak berubah saat judul diubah, supaya
  /// tautan yang sudah dibagikan tidak putus.
  slug         String        @unique
  title        String
  summary      String
  content      String
  thumbnailUrl String?
  /// Atribusi sumber untuk tulisan yang merangkum media lain (mitigasi hak
  /// cipta, PRD bagian 9).
  sourceName   String?
  sourceUrl    String?
  categoryId   String
  /// Admin yang menulis. Dilepas, bukan ikut terhapus, kalau akunnya dihapus.
  authorId     String?
  status       ArticleStatus @default(DRAFT)
  /// Diisi saat pertama kali terbit dan tidak diubah lagi, sehingga urutan
  /// daftar tidak melompat setiap kali artikel diterbitkan ulang.
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Restrict: kategori yang masih berisi artikel tidak boleh terhapus diam-diam.
  category  ArticleCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author    User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  bookmarks Bookmark[]

  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
}

/// Artikel favorit milik user (F-16).
model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId, createdAt])
}

/// Instrumen game simulasi investasi (F-10). Datanya sintetis, bukan emiten
/// atau produk sungguhan, dan dikelola lewat seed dengan id tetap.
model SimInstrument {
  id               String            @id @default(uuid())
  /// Kode pendek yang dipakai di URL, mis. NUSA atau RDPU.
  code             String            @unique
  type             SimInstrumentType
  name             String
  /// Jenis reksa dana untuk layar hasil, mis. "Pasar Uang". Kosong untuk saham.
  fundType         String?
  description      String
  /// Catatan tambahan, mis. bahwa dana dikelola Manajer Investasi.
  note             String?
  riskLevel        SimLevel
  returnPotential  SimLevel
  /// Saran jangka waktu untuk ditampilkan, mis. "1–2 tahun".
  horizonText      String?
  minInvestment    Decimal           @db.Decimal(14, 2)
  /// Harga per lembar atau NAV per unit acuan pasar sintetis.
  basePrice        Decimal           @db.Decimal(14, 2)
  /// Parameter mesin simulasi per tahun (bukan nominal uang).
  annualDrift      Float
  annualVolatility Float
  sortOrder        Int               @default(0)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  sessions SimulationSession[]

  @@index([type, isActive])
}

/// Satu kali bermain: membeli satu instrumen dengan modal virtual, lalu maju
/// per checkpoint sampai 1 tahun. Seluruh perjalanan harga ditentukan oleh
/// `seed` beserta parameter yang disalin saat sesi dibuat, sehingga hasilnya
/// bisa dihitung ulang kapan pun dan tidak berubah walau instrumennya diubah.
model SimulationSession {
  id               String    @id @default(uuid())
  userId           String
  instrumentId     String
  seed             String
  annualDrift      Float
  annualVolatility Float
  startingCash     Decimal   @db.Decimal(14, 2)
  investedAmount   Decimal   @db.Decimal(14, 2)
  cashLeft         Decimal   @db.Decimal(14, 2)
  units            Decimal   @db.Decimal(18, 6)
  buyPrice         Decimal   @db.Decimal(14, 2)
  /// 0 = baru membeli, 1..4 = checkpoint 1 Hari, 1 Bulan, 6 Bulan, 1 Tahun.
  currentStep      Int       @default(0)
  status           SimStatus @default(RUNNING)
  finalValue       Decimal?  @db.Decimal(14, 2)
  finishedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Instrumen yang sudah pernah dimainkan dinonaktifkan, bukan dihapus.
  instrument SimInstrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  events     SimEvent[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([instrumentId])
}

/// Event edukasi yang terjadi di sebuah sesi. Teksnya disalin dari template
/// supaya riwayat sesi lama tidak ikut berubah kalau templatenya diperbarui.
model SimEvent {
  id          String   @id @default(uuid())
  sessionId   String
  /// Checkpoint yang memunculkan event ini (1..4).
  step        Int
  /// Hari ke berapa sejak membeli event ini terjadi.
  day         Int
  headline    String
  explanation String
  /// Perubahan nilai akibat event dalam persen, mis. -8 atau 0.3.
  impactPct   Float
  createdAt   DateTime @default(now())

  session SimulationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, day])
}
