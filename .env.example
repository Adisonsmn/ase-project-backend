# development | test | production
NODE_ENV=development

PORT=3000

# PENTING (Supabase): pakai connection string "Session Pooler", BUKAN "Direct connection".
#
#   Direct  : postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
#   Pooler  : postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Host direct connection (db.<ref>.supabase.co) hanya punya record AAAA alias
# IPv6-only. Di jaringan tanpa IPv6 — termasuk mayoritas ISP rumahan dan kampus
# di Indonesia — koneksi akan selalu gagal dengan error Prisma P1001
# "Can't reach database server", meskipun project Supabase-nya aktif.
# Session Pooler punya alamat IPv4, jadi selalu bisa dihubungi.
#
# Ambil URL-nya di dashboard Supabase: tombol Connect > Session pooler.
# Perhatikan username pooler memakai format postgres.<project-ref>, bukan postgres.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Minimal 32 karakter, dan keduanya HARUS berbeda.
# Buat dengan: openssl rand -base64 48
JWT_ACCESS_SECRET="ganti-dengan-secret-acak-minimal-32-karakter"
JWT_REFRESH_SECRET="ganti-dengan-secret-acak-lain-minimal-32-karakter"

# Daftar origin yang diizinkan, dipisahkan koma.
# Wajib diisi saat NODE_ENV=production. Kosong di development = izinkan semua.
CORS_ORIGIN="http://localhost:5173"
